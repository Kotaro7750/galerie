# APIのURL。通常は同一オリジンの /api/v0 を利用する。
VITE_API_BASE_URL=/api/v0
# 開発サーバーの /api 転送先（ブラウザには公開されない）。
API_PROXY_TARGET=http://localhost:3000

# true のビルドだけ認証を有効にする。未指定時と false は認証なし。
VITE_AUTH_ENABLED=false
# 認証を有効にする場合の OIDC issuer URL と公開クライアントID。
# VITE_AUTH_AUTHORITY=https://id.example.com
# VITE_AUTH_CLIENT_ID=galerie
# OAuth 2.0 Resource Indicator (RFC 8707)。未指定時はアクセス中のSPAオリジンを使用する。
# Cognitoでは発行されるaccess tokenのaudになる。
# VITE_AUTH_RESOURCE=https://api.galerie.example.com
# VITE_AUTH_SCOPE=openid profile
